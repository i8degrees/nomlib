// From vendor/common.h

// It's pi(ish)...
static const float PI = 3.14159265358979323846f;

// It's pi(ish)...divided by 360.0f!
static const float PI_OVER_360 = PI / 360.0f;

// Radians to degrees
static inline double RadToDeg(const double deg)
{
  return deg * 180.0 / PI;
};

// Degrees to radians
static inline double DegToRad(const double rad)
{
  return rad * PI / 180.0;
};

#define NOM_DELETE_PTR(var) \
  if(var != nullptr) { \
    delete var; \
    var = nullptr; \
  }

#define NOM_DELETE_SMART_PTR(var) \
  if(var != nullptr) var.reset();

#define NOM_DELETE_VOID_PTR(var) \
  if(var != nullptr) { \
    free(var); \
    var = nullptr; \
  }

#if defined(DEBUG)
  #if !defined(NOM_ASSERT)
    #define NOM_ASSERT(expr) \
      assert(expr)
  #endif
#else
  #define NOM_ASSERT(expr)
#endif

// This enumeration is filled in by libsndfile
enum AudioTags
{
  SOUND_TAG_UNDEFINED = 0,
  SOUND_TAG_TITLE,
  SOUND_TAG_COPYRIGHT,
  SOUND_TAG_SOFTWARE,
  SOUND_TAG_ARTIST,
  SOUND_TAG_COMMENT,
  SOUND_TAG_DATE,
  SOUND_TAG_ALBUM,
  SOUND_TAG_LICENSE,
  SOUND_TAG_TRACK_NUMBER,
  SOUND_TAG_GENRE,
};

// This enumeration is filled in by libsndfile
enum AudioFormat
{
  AUDIO_FORMAT_UNKNOWN = 0,

  /// \brief Signed 8-bit integer sample data
  AUDIO_FORMAT_S8,

  /// \brief Unsigned 8-bit integer sample data
  AUDIO_FORMAT_U8,

  /// \brief Signed 16-bit integer sample data
  AUDIO_FORMAT_S16,

  /// \brief Signed 24-bit integer sample data
  AUDIO_FORMAT_S24,

  /// \brief Signed 32-bit integer sample data
  AUDIO_FORMAT_S32,

  /// \brief 32-bit IEEE floating-point sample data
  AUDIO_FORMAT_R32,

  /// \brief 64-bit IEEE floating-point sample data
  AUDIO_FORMAT_R64,
};

