{
  "version": 8,
  "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
  "configurePresets": [
    {
      "name": "nomlib-d_configure",
      "displayName": "Configure engine defaults for Linux",
      "description": "Build nomlib library with DEBUG enabled on Linux",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/dist/${presetName}",
      "cacheVariables": {
        "OPENGL_GL_PREFERENCE": "GLVND",
        "DEBUG": "ON",
        "DEBUG_ASSERT": "ON",
        "EXAMPLES": "ON",
        "NOM_BUILD_TESTS": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist/${presetName}",
        "NOMLIB_DEPS_DIR": "${sourceDir}/third-party",
        "GTEST_INCLUDE_DIR": "${sourceDir/third-party/linux/gtest/include",
        "NOM_USE_CREATIVE_OPENAL": "1",
        "NOM_USE_OPENAL": "1"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "nomlib-d_build",
      "description": "Build engine library for Linux (DEBUG)",
      "displayName": "nomlib-d_build",
      "configurePreset": "nomlib-d_configure"
    }
  ]
}
