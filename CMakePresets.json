      "cacheVariables": {
        "CMAKE_RELEASE_POSTFIX": "_static",
        "CMAKE_BUILD_TYPE": "Debug",
        "DEBUG_ASSERT": "on",
        "CMAKE_C_COMPILER": "/usr/bin/clang-cl",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang-cl",
