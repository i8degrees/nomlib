        "CMAKE_BUILD_TYPE": "Debug",
        "DEBUG_ASSERT": "ON",
        "BUILD_EXAMPLES": "ON",
        "BUILD_TESTS": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "CMAKE_INSTALL_PREFIX": "$env{HOME}/Library-d"
      },
      "environment": {
        "CC": "/usr/bin/clang",
        "CXX": "/usr/bin/clang++",
