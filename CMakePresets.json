        "CMAKE_BUILD_TYPE": "Debug",
        "DEBUG_ASSERT": "on",
        "CMAKE_C_COMPILER": "/usr/bin/clang-cl",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang-cl",
        "BUILD_EXAMPLES": "ON",
        "BUILD_TESTS": "OFF",
        "NOMLIB_DEPS_DIR": "${sourceDir}/vendor/prebuild",
        "NOM_USE_OPENAL": "0",
        "NOM_USE_OPENAL_SOFT": "0",
        "NOM_BUILD_AUDIO_UNIT": "off",
