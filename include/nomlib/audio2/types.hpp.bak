struct OALSource {
  uint32 source;
  bool used;

  OALSource(uint32 src) {
    source = src;
    used = false;
  }
};

enum SoundPriority: uint32 {
  SOUND_PRIORITY_LOW = 0x00,
  SOUND_PRIORITY_MEDIUM = 0x02,
  SOUND_PRIORITY_HIGH = 0x04,
  SOUND_PRIORITY_ALWAYS = 0x6,
};

