    {
      "name": "docker-linux",
      "displayName": "build nomlib with docker backend - bin/docker/build.sh",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "/usr/local",
        "OPENGL_GL_PREFERENCE": "GLVND",
        "BUILD_EXAMPLES": "ON",
        "BUILD_TESTS": "ON"
      },
      "environment": {
        "_SDLDIR": "${sourceDir}/vendor/prebuild/linux/sdl2",
