@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# third-party vendor libraries nomlib requires
find_dependency(SDL2 2.32.10)
find_dependency(SDL2_image 2.8.12)
find_dependency(SDL2_ttf 2.24.0)
find_dependency(libRocket 1.3.0.0)
find_dependency(OpenAL 1.25.1)
find_dependency(SndFile 1.2.2)

set(nomlib_known_comps static shared)
set(nomlib_comp_static NO)
set(nomlib_comp_shared NO)
foreach (nomlib_comp IN LISTS ${CMAKE_FIND_PACKAGE_NAME}_FIND_COMPONENTS)
    if (nomlib_comp IN_LIST nomlib_known_comps)
        set(nomlib_comp_${nomlib_comp} YES)
    else ()
        set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
            "nomlib does not recognize component `${nomlib_comp}`.")
        set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
        return()
    endif ()
endforeach ()

if (nomlib_comp_static AND nomlib_comp_shared)
    set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
        "nomlib `static` and `shared` components are mutually exclusive.")
    set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
    return()
endif()

set(nomlib_static_targets "${CMAKE_CURRENT_LIST_DIR}/nomlib-static-targets.cmake")
set(nomlib_shared_targets "${CMAKE_CURRENT_LIST_DIR}/nomlib-shared-targets.cmake")

macro(nomlib_load_targets type)
    if (NOT EXISTS "${nomlib_${type}_targets}")
        set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
            "nomlib `${type}` libraries were requested but not found.")
        set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
        return()
    endif ()
    include("${nomlib_${type}_targets}")
endmacro()

if(nomlib_comp_static)
  nomlib_load_targets(static)
elseif(nomlib_comp_shared)
  nomlib_load_targets(shared)
elseif(DEFINED nomlib_SHARED_LIBS AND nomlib_SHARED_LIBS)
  nomlib_load_targets(shared)
elseif(DEFINED nomlib_SHARED_LIBS AND NOT nomlib_SHARED_LIBS)
  nomlib_load_targets(static)
elseif(BUILD_SHARED_LIBS)
    if(EXISTS "${nomlib_shared_targets}")
      nomlib_load_targets(shared)
    else()
      nomlib_load_targets(static)
    endif()
else()
    if(EXISTS "${nomlib_static_targets}")
      nomlib_load_targets(static)
    else()
      nomlib_load_targets(shared)
    endif()
endif()

